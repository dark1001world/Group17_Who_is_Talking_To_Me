import os
import sys
import numpy as np
import torchaudio
import pickle
import json
import cv2
from tqdm import tqdm
from scipy.optimize import linear_sum_assignment

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from src.utils.config import load_config
from src.utils.logger import setup_logger
from src.utils.alignment import TimeGridGenerator
from src.tracking.face_tracker import FaceTracker
from src.visual.feature_extractor import VisualFeatureExtractor
from src.audio.embedding_extractor import AudioEmbeddingExtractor

def iou(boxA, boxB):
    xA = max(boxA[0], boxB[0]); yA = max(boxA[1], boxB[1])
    xB = min(boxA[2], boxB[2]); yB = min(boxA[3], boxB[3])
    inter = max(0, xB-xA) * max(0, yB-yA)
    areaA = (boxA[2]-boxA[0])*(boxA[3]-boxA[1])
    areaB = (boxB[2]-boxB[0])*(boxB[3]-boxB[1])
    return inter / (areaA + areaB - inter + 1e-6)

def match_tracks_to_speakers(track_prototypes, gt_speaker_boxes, gt_speaker_embs, config):
    track_ids = list(track_prototypes.keys())
    speaker_ids = list(gt_speaker_boxes.keys()) if gt_speaker_boxes else list(gt_speaker_embs.keys())
    if not track_ids or not speaker_ids:
        return {}

    cost_matrix = np.zeros((len(track_ids), len(speaker_ids)))
    for i, tid in enumerate(track_ids):
        t_emb = track_prototypes[tid]['avg_emb']
        t_boxes = track_prototypes[tid]['boxes']
        for j, sid in enumerate(speaker_ids):
            s_boxes = gt_speaker_boxes.get(sid, []) if gt_speaker_boxes else []
            s_emb = gt_speaker_embs.get(sid, None)
            iou_cost = 0.5
            if config['label_matching']['use_iou'] and s_boxes:
                iou_vals = [max([iou(tb, sb) for sb in s_boxes]) if s_boxes else 0 for tb in t_boxes]
                iou_cost = 1 - np.mean(iou_vals) if iou_vals else 0.5
            reid_cost = 0.5
            if config['label_matching']['use_reid'] and s_emb is not None and t_emb is not None:
                reid_cost = 1 - np.dot(t_emb, s_emb) / (np.linalg.norm(t_emb)*np.linalg.norm(s_emb)+1e-6)
            if config['label_matching']['use_iou'] and config['label_matching']['use_reid']:
                cost = 0.5 * iou_cost + 0.5 * reid_cost
            elif config['label_matching']['use_iou']:
                cost = iou_cost
            else:
                cost = reid_cost
            cost_matrix[i, j] = cost

    row_ind, col_ind = linear_sum_assignment(cost_matrix)
    all_costs = cost_matrix[row_ind, col_ind]
    thresh = np.percentile(all_costs, config['label_matching']['cost_threshold_percentile']) if len(all_costs) > 0 else 0.7
    mapping = {}
    for r, c in zip(row_ind, col_ind):
        if cost_matrix[r,c] < thresh:
            mapping[track_ids[r]] = speaker_ids[c]
    return mapping


def main():
    config = load_config('configs/default.yaml')
    logger = setup_logger('extract_features', config['logging']['log_dir'])
    os.makedirs(config['data']['output_dir'], exist_ok=True)

    audio_extractor = AudioEmbeddingExtractor(
        model_name=config['audio']['model_name'].split('/')[-1].split('-')[0],
        device=config['training']['device']
    )
    visual_extractor = VisualFeatureExtractor(config, device=config['training']['device'])
    tracker = FaceTracker(
        device=config['training']['device'],
        iou_threshold=config['tracking']['iou_threshold'],
        max_lost=config['tracking']['max_lost'],
        reid_model=visual_extractor.reid_model,
        min_track_length=config['tracking']['min_track_length']
    )

    audio_dir = config['data']['audio_dir']
    frames_dir = config['data']['frames_dir']
    annotation_dir = config['data']['annotation_dir']

    # Load big annotation file once and index by clip UID
    ann_file = "/DATA/G17/ego4d_data/v2/ttm_train.json"
    with open(ann_file, 'r') as f:
        big_annotations = json.load(f)
    ann_lookup = {item['clip_uid']: item for item in big_annotations}

    for audio_file in tqdm(os.listdir(audio_dir)):
        if not audio_file.endswith('.wav'):
            continue

        base_name = os.path.splitext(audio_file)[0]
        audio_path = os.path.join(audio_dir, audio_file)
        clip_frames_dir = os.path.join(frames_dir, base_name)

        if not os.path.isdir(clip_frames_dir):
            logger.warning(f"Skipping {base_name}: missing frames")
            continue

        annotations = ann_lookup.get(base_name, [])
        if not annotations:
            logger.warning(f"No annotation found for {base_name}")
            continue
        if isinstance(annotations, dict) and 'social_segments_talking' in annotations:
            annotations = annotations['social_segments_talking']
        elif not isinstance(annotations, list):
            annotations = []

        info = torchaudio.info(audio_path)
        clip_duration = info.num_frames / info.sample_rate

        grid = TimeGridGenerator(clip_duration, stride=config['alignment']['stride'],
                                 video_fps=config['alignment']['video_fps'])
        time_centers = grid.time_centers

        audio_features, total_samples = audio_extractor.extract_features_full(audio_path)

        audio_seq = []
        visual_seq = []
        track_boxes = {}
        all_track_embs = {}

        for t_idx, t in enumerate(time_centers):
            aud_emb = audio_extractor.get_embedding_at_time(audio_features, total_samples, t, config['alignment']['window_size'])
            audio_seq.append(aud_emb)

            frame_path = grid.get_frame_path(clip_frames_dir, t)
            if not os.path.exists(frame_path):
                visual_seq.append({})
                continue
            frame_bgr = cv2.imread(frame_path)
            if frame_bgr is None:
                visual_seq.append({})
                continue
            frame_rgb = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2RGB)
            tracked_faces = tracker.update(frame_rgb)
            face_features = visual_extractor.extract_features(frame_rgb, tracked_faces, t)
            visual_seq.append(face_features)

            for face_info in tracked_faces:
                tid = face_info['id']
                bbox = face_info['bbox']
                if tid not in track_boxes:
                    track_boxes[tid] = []
                    all_track_embs[tid] = []
                track_boxes[tid].append(bbox)
                if tid in face_features:
                    all_track_embs[tid].append(face_features[tid])

        track_prototypes = {}
        for tid in track_boxes:
            if len(all_track_embs[tid]) > 0:
                avg_emb = np.mean(all_track_embs[tid], axis=0)
                track_prototypes[tid] = {'avg_emb': avg_emb, 'boxes': track_boxes[tid]}

        gt_speaker_boxes = {}
        gt_speaker_embs = {}
        for event in annotations:
            sid = event['speaker_id']
            if 'bbox' in event:
                if sid not in gt_speaker_boxes:
                    gt_speaker_boxes[sid] = []
                gt_speaker_boxes[sid].append(event['bbox'])
            if 'emb' in event:
                gt_speaker_embs[sid] = np.array(event['emb'])

        track_to_speaker = match_tracks_to_speakers(track_prototypes, gt_speaker_boxes, gt_speaker_embs, config)
        logger.info(f"{base_name}: matched {len(track_to_speaker)} tracks to speakers")

        all_track_ids = sorted(track_prototypes.keys())
        T = len(time_centers)
        N = len(all_track_ids)
        if N == 0:
            logger.warning(f"{base_name}: no valid tracks, skipping")
            continue

        D_vis = len(next(iter(all_track_embs.values()))[0])
        visual_array = np.zeros((T, N, D_vis), dtype=np.float32)
        track_mask = np.zeros((T, N), dtype=bool)
        labels = np.zeros((T, N), dtype=np.float32)

        for t in range(T):
            for j, tid in enumerate(all_track_ids):
                if t < len(track_boxes[tid]) and tid in visual_seq[t]:
                    visual_array[t, j] = visual_seq[t][tid]
                    track_mask[t, j] = True

        for t_idx, t_center in enumerate(time_centers):
            for j, tid in enumerate(all_track_ids):
                if tid in track_to_speaker:
                    sid = track_to_speaker[tid]
                    for event in annotations:
                        if event['speaker_id'] == sid:
                            if event['start'] <= t_center <= event['end']:
                                labels[t_idx, j] = 1.0
                                break

        audio_array = np.stack(audio_seq, axis=0)
        np.save(os.path.join(config['data']['output_dir'], f"{base_name}_audio.npy"), audio_array)
        np.save(os.path.join(config['data']['output_dir'], f"{base_name}_visual.npy"), visual_array)
        np.save(os.path.join(config['data']['output_dir'], f"{base_name}_mask.npy"), track_mask)
        np.save(os.path.join(config['data']['output_dir'], f"{base_name}_labels.npy"), labels)
        with open(os.path.join(config['data']['output_dir'], f"{base_name}_track_ids.pkl"), 'wb') as f:
            pickle.dump(all_track_ids, f)

        logger.info(f"Processed {base_name}: T={T}, N={N}")

if __name__ == "__main__":
    main()
